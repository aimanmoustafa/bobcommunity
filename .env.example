# Discord
DISCORD_TOKEN=
DISCORD_GUILD_ID=
DISCORD_WATCHED_CHANNELS=1025348385374470175,1025354085672693790,1025354191427866624

# Optional: Discord user IDs (comma-separated) to also DM with reports,
# new urgent alerts, and toxicity moderation pings, alongside Slack.
# Leave unset to disable DMs entirely.
DISCORD_DM_USER_IDS=

# Dedicated recipient for leave-DM reply forwards specifically (separate
# from the general alert list above). Defaults to 847724185434325033 if unset.
DISCORD_PRIMARY_USER_ID=847724185434325033

# Slack
SLACK_BOT_TOKEN=
SLACK_CHANNEL_ID=
SLACK_CHANNEL_ALERTS=
SLACK_CHANNEL_BUGS=
SLACK_CHANNEL_BALANCE=
SLACK_CHANNEL_MODERATION=
SLACK_CHANNEL_DIGEST=
SLACK_CHANNEL_MEMBER_EXITS=

# AI (Anthropic Claude) -- optional at boot; if unset, the bot runs but
# skips classification (Discord/Slack/exit DMs still work).
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Database
DATABASE_URL=

# Aggregation window for grouping repeat reports into one updating alert
AGGREGATION_WINDOW_MINUTES=120

# Display timezone for /community peak (activity data is stored in UTC
# either way -- this only affects how times are shown). Default +2 = Cairo.
TIMEZONE_OFFSET_HOURS=2

# How many hours an unanswered "needs reply" item can sit before it
# triggers a one-time stale alert (DM-only, not Slack).
STALE_REPLY_HOURS=24

# Used only by /community notiondata -- individual messages don't carry a
# build version, so this is your manually-set "current build" default,
# matching the same convention the manual Notion logging workflow uses.
CURRENT_BOB_BUILD=

MEMBER_EXIT_MESSAGE=

# Sent on join. Its real purpose is opening a DM channel while a shared
# server still clearly exists, so the exit-feedback DM above has an actual
# chance of landing later -- Discord blocks opening one cold once someone's
# already left, but tends to keep an existing channel usable.
MEMBER_WELCOME_MESSAGE=Welcome to Blitz of Battle! Glad to have you here!
LOG_MEMBER_EXITS_TO_SLACK=false

# Optional: Notion sync. Create an internal integration at
# https://www.notion.so/my-integrations, share your Community Management,
# Bugs, and Features databases with it, then paste the secret here.
# Leave unset to disable Notion sync entirely.
NOTION_API_KEY=

LOG_LEVEL=info
PORT=3000
