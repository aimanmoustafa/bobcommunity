# Discord
DISCORD_TOKEN=your_discord_bot_token
DISCORD_GUILD_ID=your_server_id

# Optional: comma-separated channel IDs to watch. Leave blank to watch every channel.
DISCORD_WATCHED_CHANNELS=1025348385374470175,1025354085672693790,1025354191427866624

# OpenAI (optional at boot -- bot runs without it, AI classification disabled until set)
OPENAI_API_KEY=your_openai_api_key
OPENAI_MODEL=gpt-4o-mini

# Slack
SLACK_BOT_TOKEN=xoxb-your-slack-bot-token

# Default/fallback channel (used if a specific one below isn't set)
SLACK_CHANNEL_ID=your-default-channel-id

# Optional: route different alert types to different channels.
# Any left unset will fall back to SLACK_CHANNEL_ID above.
SLACK_CHANNEL_ALERTS=community-alerts-channel-id
SLACK_CHANNEL_BUGS=bug-reports-channel-id
SLACK_CHANNEL_BALANCE=balance-feedback-channel-id
SLACK_CHANNEL_FEEDBACK=community-feedback-channel-id
SLACK_CHANNEL_MODERATION=community-moderation-channel-id
SLACK_CHANNEL_DIGEST=community-digest-channel-id
SLACK_CHANNEL_MEMBER_EXITS=member-exits-channel-id

# Database (Railway Postgres internal connection string)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# Bot Config
# How long (minutes) repeat reports of the same issue in the same channel
# get merged into one updating Slack alert instead of spawning new ones.
AGGREGATION_WINDOW_MINUTES=120
LOG_LEVEL=info
PORT=3000

# Message DMed to members when they leave the server
MEMBER_EXIT_MESSAGE="Hey there! You were part of the Blitz of Battle community and we noticed you left. We'd really appreciate your feedback.\n\nWhat were you hoping to see but didn't find? What made you leave? What would you like to see improved?\n\nYour input helps us make the game and community better."
