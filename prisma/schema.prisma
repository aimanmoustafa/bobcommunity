generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Feedback {
  id                  String    @id @default(cuid())
  messageId           String    @unique
  authorId            String
  authorName          String
  channelId           String
  channelName         String
  guildId             String
  content             String
  messageLink         String
  category            String
  tags                String[]  @default([])
  sentiment           String
  urgency             String    @default("low")
  needsReply          String    @default("no")
  reason              String?
  aiSummary           String?
  confidence          Float     @default(0)
  replyStatus         String    @default("pending")
  repliedBy           String?
  respondedAt         DateTime?
  responseTimeMinutes Int?
  staleAlertSent      Boolean   @default(false)
  slackNotified       Boolean   @default(false)
  slackTs             String?
  issueId             String?
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([channelId])
  @@index([category])
  @@index([createdAt])
}

model Issue {
  id                  String    @id @default(cuid())
  title               String
  category            String
  priority            String    @default("medium")
  status              String    @default("new") // new | investigating | acknowledged | in_progress | resolved | ignored
  mentionCount        Int       @default(1)
  uniqueUserIds       String[]  @default([])
  sentiment           String    @default("negative")
  latestSummary       String?
  recommendedAction   String?
  assignedTo          String?
  followUpFlagged     Boolean   @default(false)
  notionCmPageId      String?
  notionCmPageUrl     String?
  notionBugPageId     String?
  notionFeaturePageId String?
  firstReported       DateTime  @default(now())
  lastReported        DateTime  @default(now())
  createdAt           DateTime  @default(now())
  updatedAt           DateTime  @updatedAt

  @@index([status])
  @@index([category])
  @@index([lastReported])
}

model DailyCategoryCount {
  id       String   @id @default(cuid())
  date     DateTime
  category String
  count    Int      @default(0)

  @@unique([date, category])
}

// Singleton row (id is always "singleton") tracking scheduled task run times,
// so a restart near the trigger window never causes a skipped or duplicated report.
model SchedulerState {
  id         String    @id @default(cuid())
  taskName   String    @unique
  lastRunAt  DateTime?
  updatedAt  DateTime  @updatedAt
}

// Tracks in-progress alert aggregation groups so repeat reports of the same
// issue update one Slack message in place instead of spamming new alerts.
model AggregationGroup {
  id            String   @id @default(cuid())
  key           String   @unique
  category      String
  channelId     String
  slackTs       String?
  slackChannel  String?
  reporterCount Int      @default(1)
  reporterIds   String[] @default([])
  latestSummary String?
  latestUrgency String   @default("low")
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

// Per-channel checkpoint for incremental backfill/refresh, so repeated runs
// only process genuinely new messages.
model ChannelCheckpoint {
  id               String   @id @default(cuid())
  channelId        String   @unique
  lastMessageId    String?
  lastProcessedAt  DateTime @default(now())
  updatedAt        DateTime @updatedAt
}

// Singleton row (id is always "singleton") tracking whether the AI layer is
// actually succeeding, so reports/refresh can surface real failures instead
// of silently showing "0 feedback" when the AI API is broken.
model AiHealthState {
  id                String    @id @default("singleton")
  lastSuccessAt     DateTime?
  lastErrorAt       DateTime?
  lastErrorMessage  String?
  consecutiveErrors Int       @default(0)
  totalCalls        Int       @default(0)
  totalErrors       Int       @default(0)
  updatedAt         DateTime  @updatedAt
}

// Tracks who received the exit-feedback DM, so a later reply from that same
// user (in the DM channel, after they've left the server) can be recognized
// and forwarded to the configured DM user(s) instead of being ignored.
model ExitDmRecipient {
  id        String    @id @default(cuid())
  userId    String    @unique
  username  String
  sentAt    DateTime  @default(now())
  repliedAt DateTime?
}

// Activity heatmap (all-time recurring pattern): "Tuesdays at 8pm in
// general" -- accumulates forever, bounded at 168 rows (7 days x 24 hours).
model ActivityBucket {
  id           String @id @default(cuid())
  dayOfWeek    Int // 0=Sunday .. 6=Saturday (UTC)
  hour         Int // 0-23 (UTC)
  messageCount Int    @default(0)

  @@unique([dayOfWeek, hour])
}

model ActivityBucketAuthor {
  id        String @id @default(cuid())
  dayOfWeek Int
  hour      Int
  authorId  String

  @@unique([dayOfWeek, hour, authorId])
}

// Per-CALENDAR-DATE hourly buckets, needed to answer "what happened in just
// the last 24h/7d/30d" -- the tables above only know "Tuesdays in general",
// with no way to scope to a specific recent window.
model DailyActivityBucket {
  id           String   @id @default(cuid())
  date         DateTime @db.Date
  hour         Int
  messageCount Int      @default(0)

  @@unique([date, hour])
  @@index([date])
}

model DailyActivityBucketAuthor {
  id       String   @id @default(cuid())
  date     DateTime @db.Date
  hour     Int
  authorId String

  @@unique([date, hour, authorId])
  @@index([date])
}
