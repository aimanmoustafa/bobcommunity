generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Feedback {
  id            String   @id @default(cuid())
  messageId     String   @unique
  authorId      String
  authorName    String
  channelId     String
  channelName   String
  guildId       String
  content       String
  messageLink   String
  category      String
  tags          String[] @default([])
  sentiment     String   @default("neutral")
  urgency       String   @default("low")
  needsReply    String   @default("no")
  reason        String?
  aiSummary     String?
  suggestedReply String?
  confidence    Float    @default(0)
  replyStatus   String   @default("pending")
  repliedBy     String?
  slackNotified Boolean  @default(false)
  slackTs       String?
  issueId       String?
  issue         Issue?   @relation(fields: [issueId], references: [id])
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([category])
  @@index([urgency])
  @@index([needsReply])
  @@index([createdAt])
  @@index([channelId])
  @@index([issueId])
}

model Issue {
  id                String     @id @default(cuid())
  title             String
  category          String
  priority          String     @default("medium")
  status            String     @default("new") // new | investigating | acknowledged | in_progress | resolved | ignored
  mentionCount      Int        @default(1)
  uniqueUserIds     String[]   @default([])
  sentiment         String     @default("negative")
  latestSummary     String?
  recommendedAction String?
  assignedTo        String?
  followUpFlagged   Boolean    @default(false)
  // Notion sync: which page(s) this issue is mirrored to, so repeat reports
  // update the existing page instead of creating a duplicate every time.
  notionCmPageId    String?
  notionCmPageUrl   String?
  notionBugPageId   String?
  notionFeaturePageId String?
  firstReported     DateTime   @default(now())
  lastReported      DateTime   @default(now())
  createdAt         DateTime   @default(now())
  updatedAt         DateTime   @updatedAt
  feedback          Feedback[]

  @@index([status])
  @@index([category])
  @@index([lastReported])
}

model DailyCategoryCount {
  id       String   @id @default(cuid())
  date     DateTime @db.Date
  category String
  count    Int      @default(0)

  @@unique([date, category])
  @@index([category, date])
}

model SchedulerState {
  id        String    @id @default(cuid())
  taskName  String    @unique
  lastRunAt DateTime?
  updatedAt DateTime  @updatedAt
}

model AggregationGroup {
  id            String   @id @default(cuid())
  key           String   @unique
  category      String
  channelId     String
  slackTs       String?
  slackChannel  String?
  reporterCount Int      @default(1)
  reporterIds   String[] @default([])
  latestSummary String?
  latestUrgency String   @default("low")
  expiresAt     DateTime
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  @@index([key])
  @@index([expiresAt])
}

model ChannelCheckpoint {
  id              String   @id @default(cuid())
  channelId       String   @unique
  lastMessageId   String?
  lastProcessedAt DateTime @default(now())
  updatedAt       DateTime @updatedAt
}

// Singleton row (id is always "singleton") tracking whether the AI layer is
// actually succeeding, so reports/refresh can surface real failures instead
// of silently showing "0 feedback" when the AI API is broken.
model AiHealthState {
  id                String    @id @default("singleton")
  lastSuccessAt     DateTime?
  lastErrorAt       DateTime?
  lastErrorMessage  String?
  consecutiveErrors Int       @default(0)
  totalCalls        Int       @default(0)
  totalErrors       Int       @default(0)
  updatedAt         DateTime  @updatedAt
}

// Tracks who received the exit-feedback DM, so a later reply from that same
// user (in the DM channel, after they've left the server) can be recognized
// and forwarded to the configured DM user(s) instead of being ignored.
model ExitDmRecipient {
  id        String    @id @default(cuid())
  userId    String    @unique
  username  String
  sentAt    DateTime  @default(now())
  repliedAt DateTime?
}

// Activity heatmap for finding peak engagement times (e.g. best time to run
// an event). Tracks EVERY message in watched channels -- including casual
// chat that never becomes "feedback" -- since raw activity volume is exactly
// the signal needed here, unlike the Feedback table which is a filtered
// subset. Bucketed by (dayOfWeek, hour) in UTC; capped at 168 rows total
// since it's a fixed weekly grid that just accumulates counts over time.
model ActivityBucket {
  id           String @id @default(cuid())
  dayOfWeek    Int // 0=Sunday .. 6=Saturday (UTC)
  hour         Int // 0-23 (UTC)
  messageCount Int    @default(0)

  @@unique([dayOfWeek, hour])
}

// One row per (time slot, author) ever seen -- lets us count unique active
// participants per slot, not just raw message volume, without needing to
// store unbounded per-message history. Bounded by (168 slots) x (distinct
// active members), which stays reasonable even for a large community.
model ActivityBucketAuthor {
  id        String @id @default(cuid())
  dayOfWeek Int
  hour      Int
  authorId  String

  @@unique([dayOfWeek, hour, authorId])
}
